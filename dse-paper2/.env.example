# dse-paper2 env example — DO NOT COMMIT REAL VALUES
# Copy to .env and fill in. .env is .gitignore'd.

# Public Firebase web config (intended to be public; not a secret).
# Obtain from Firebase console → Project settings → Your apps.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Functions-side env (server-only; set via firebase functions:secrets:set).
ALLOWED_SCHOOL_DOMAINS=phase1a.example.test
SCHOOL_DOMAIN_TO_ID=phase1a.example.test:phase1a-school
