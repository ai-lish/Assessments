{
  "name": "dse-paper2-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Phase 1A Cloud Functions for dse-paper2",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test:unit": "node test/run-unit.mjs",
